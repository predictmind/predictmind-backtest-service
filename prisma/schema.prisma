// PredictMind backtest service schema.
// PostgreSQL via the portable DATABASE_URL contract, in this service's own
// "backtest" schema. Stores each backtest run, its performance metrics, and the
// individual simulated trades (the trade log).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BacktestStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// One backtest run: a strategy applied to one coin/timeframe over a candle range.
model Backtest {
  id           String         @id @default(uuid()) @db.Uuid
  coinSymbol   String
  timeframe    String
  strategyName String
  params       Json           @default("{}")
  candleCount  Int            @default(0)
  startTime    DateTime?
  endTime      DateTime?
  status       BacktestStatus @default(PENDING)
  error        String?
  createdAt    DateTime       @default(now())

  result BacktestResult?
  trades BacktestTrade[]

  @@index([coinSymbol, timeframe])
  @@map("backtests")
}

// The performance metrics for one backtest (S12.2).
model BacktestResult {
  id              String   @id @default(uuid()) @db.Uuid
  backtestId      String   @unique @db.Uuid
  backtest        Backtest @relation(fields: [backtestId], references: [id], onDelete: Cascade)
  netProfitPct    Decimal  @db.Decimal(12, 4)
  buyHoldPct      Decimal  @db.Decimal(12, 4)
  winRate         Decimal  @db.Decimal(6, 2)
  profitFactor    Decimal  @db.Decimal(12, 4)
  maxDrawdownPct  Decimal  @db.Decimal(8, 4)
  sharpe          Decimal  @db.Decimal(10, 4)
  sortino         Decimal  @db.Decimal(10, 4)
  expectancyPct   Decimal  @db.Decimal(10, 4)
  avgTradePct     Decimal  @db.Decimal(10, 4)
  tradesCount     Int
  finalEquity     Decimal  @db.Decimal(18, 4)
  createdAt       DateTime @default(now())

  @@map("backtest_results")
}

// One simulated spot trade: buy, then a later sell (S12.3 trade log).
model BacktestTrade {
  id         String   @id @default(uuid()) @db.Uuid
  backtestId String   @db.Uuid
  backtest   Backtest @relation(fields: [backtestId], references: [id], onDelete: Cascade)
  entryTime  DateTime
  entryPrice Decimal  @db.Decimal(20, 8)
  exitTime   DateTime
  exitPrice  Decimal  @db.Decimal(20, 8)
  pnlPct     Decimal  @db.Decimal(12, 4)
  bars       Int

  @@index([backtestId])
  @@map("backtest_trades")
}
