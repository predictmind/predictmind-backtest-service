# Portable configuration for the backtest service.
# Copy to .env for local development.

# Any PostgreSQL provider. The backtest service uses its own "backtest" schema.
DATABASE_URL=postgresql://predictmind:predictmind@localhost:5432/predictmind?schema=backtest

PORT=3006

# The market service, used to fetch historical candles (east-west call).
MARKET_SERVICE_URL=http://localhost:3003
